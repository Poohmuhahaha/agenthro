{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "agenthro-prod",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"routes": [
		{ "pattern": "agenthro.creativelabth.com", "custom_domain": true },
		{ "pattern": "agenthrocms.creativelabth.com", "custom_domain": true },
	],
	"vars": {
		"EMDASH_SITE_URL": "https://agenthro.creativelabth.com",
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "agenthro-prod-db",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "agenthro-prod-media",
		},
	],
	// Co-editing rooms, one Durable Object per entry being edited
	"durable_objects": {
		"bindings": [{ "name": "EMDASH_ROOMS", "class_name": "EmDashRoom" }],
	},
	"exports": {
		"EmDashRoom": { "type": "durable-object", "storage": "sqlite" },
	},
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
